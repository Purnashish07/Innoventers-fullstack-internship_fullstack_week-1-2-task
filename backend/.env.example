PORT=5000
# Option 1 (Local MongoDB): mongodb://localhost:27017/fullstack-app
# Option 2 (MongoDB Atlas - RECOMMENDED): mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/fullstack-app
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/fullstack-app
JWT_SECRET=your_very_strong_secret_key_here
JWT_EXPIRE=7d
